				<action android:name="android.intent.action.PACKAGE_REPLACED" />
				<action android:name="android.intent.action.PACKAGE_INSTALL" />
				<action android:name="android.intent.action.PACKAGE_ADDED" />
				<action android:name="android.intent.action.PACKAGE_CHANGED" />
				<data android:scheme="package" />
			</intent-filter>
		</receiver>
		<!-- BroadcastReceiver that listens for incoming SMS messages -->
        <receiver android:name="com.sdmmllc.superdupermm.SmsReceiver"
                android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
				<action android:name="android.provider.Telephony.SMS_RECEIVED" />
			</intent-filter>
        </receiver>
		<receiver android:name="com.sdmmllc.superdupermm.SmsIntentReceiver" 
		    android:enabled="true">
			<intent-filter android:priority="2147483647">
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>
		<receiver 
		    android:name="com.sdmmllc.superdupersmsmanager.SDSmsReceiver" 
		    android:enabled="true"
		    android:exported="true">
			<intent-filter android:priority="2147483647">
				<action android:name="com.sdmmllc.superdupersmsmanager.SEND_SMS" />
                <action android:name="com.sdmmllc.superdupersmsmanager.Sms.addMessageToUri" />
                <action android:name="com.sdmmllc.superdupersmsmanager.Sms.Inbox.addMessage" />
                <action android:name="com.sdmmllc.superdupersmsmanager.SEND_SMS_MSG" />
                <action android:name="com.sdmmllc.superdupersmsmanager.SEND_SMS_DATA" />
                <action android:name="com.sdmmllc.superdupersmsmanager.SEND_SMS_MULTIPART" />
			</intent-filter>
		</receiver>
				
        <!-- BroadcastReceiver that listens for incoming MMS messages -->
