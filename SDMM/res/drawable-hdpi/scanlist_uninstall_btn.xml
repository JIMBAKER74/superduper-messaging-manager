<?xml version="1.0" encoding="utf-8"?>
<selector 
	xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true" >
		<shape>
			<gradient
				android:startColor="@color/instDarkGray"
				android:endColor="@color/instLightGray"
				android:angle="225" />
			<stroke
				android:width="3dp"
				android:color="@color/scanGreen" />
			<corners
				android:radius="3dp" />
			<padding
				android:left="4dp"
				android:top="4dp"
				android:right="4dp"
				android:bottom="4dp" />
		</shape>
	</item>
	<item 
		android:state_focused="true" >
		<shape>
			<gradient
				android:endColor="@color/scanDarkOrange"
				android:startColor="@color/scanBtnOrange"
				android:angle="225" />
			<stroke
				android:width="3dp"
				android:color="@color/scanDarkOrange" />
			<corners                 
				android:radius="3dp" />             
			<padding
				android:left="4dp"
				android:top="4dp"
				android:right="4dp"
				android:bottom="4dp" />
		</shape>
	</item>
	<item>
		<shape>
			<gradient
				android:endColor="@color/scanBtnOrange"
				android:startColor="@color/scanDarkOrange"
				android:angle="225" />
			<stroke
				android:width="3dp"
				android:color="@color/scanBtnOrange" />
			<corners
				android:radius="3dp" />
			<padding
				android:left="4dp"
				android:top="4dp"
				android:right="4dp"
				android:bottom="4dp" />
			</shape>
	</item>
</selector>