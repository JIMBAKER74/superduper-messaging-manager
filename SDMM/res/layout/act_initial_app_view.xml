<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
	android:background="@color/sdmmBlue2" 
	>
   	<LinearLayout
       	android:id="@+id/initialAppViewAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
   	    android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/selectorWarningBackground"
		/>
   	<ImageView 
   	    android:id="@+id/initialAppViewProgressBar"
   	    android:layout_width="match_parent"
   	    android:layout_height="wrap_content"
   	    android:layout_below="@id/initialAppViewAd"
   	    android:src="@drawable/img_select"
   	    android:layout_centerHorizontal="true"
   	    android:background="@color/sdmmBgGray"
   	    />
    <RelativeLayout
		android:id="@+id/initialAppViewLayout"
		android:layout_below="@id/initialAppViewProgressBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginBottom="2dp"
		android:background="@color/sdmmBgGray"
		>
        <LinearLayout
            android:id="@+id/initialAppViewDescrLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
            android:gravity="left|center_vertical"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/initialAppViewTitle"
                android:text="@string/initialAppViewTitleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:layout_marginTop="10dip"
                android:textAppearance="?android:attr/textAppearanceLarge"
                />
            <TextView
                android:id="@+id/initialAppViewDescr"
                android:text="@string/initialAppViewDescrTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                />
		</LinearLayout>
    </RelativeLayout>
	<ScrollView
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:layout_above="@+id/initialAppViewViewMessagingNextBtnLayout"
	    android:layout_below="@id/initialAppViewLayout"
		android:background="@color/sdmmBgGray"
	    >
	    <LinearLayout 
	        android:id="@+id/initialAppViewViewResultsAppsLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
	        />
	</ScrollView>
	<RelativeLayout
        android:id="@id/initialAppViewViewMessagingNextBtnLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sdmmBgGray"
        android:layout_gravity="center_vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="3dp"
        >
	    <Button
			android:id="@+id/initialAppViewViewNextBtn"
			android:onClick="viewInitialAppSelector"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialAppViewViewNextBtnTxt"
			android:paddingRight="25dip"
			android:paddingLeft="25dip"
			android:layout_marginTop="15dip"
			android:layout_marginBottom="10dip"
			android:layout_centerHorizontal="true"
			/>
    </RelativeLayout>
</RelativeLayout>
