<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#333333"
    >
	
		<TableLayout
			android:id="@+id/aboutUsLayout"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:layout_gravity="center_vertical|center_horizontal"
			android:background="@android:color/transparent"
			> 
			<TableRow>
				<TextView 
					android:id="@+id/aboutUsLbl" 
					android:text="@string/aboutUsTitleLblTxt"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" 
					android:layout_gravity="center"
					android:paddingTop="10dp"
					android:textColor="@color/instWhite"
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs1Lbl" 
					android:text="@string/aboutUsLbl1Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:layout_gravity="center"
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUsLbl"
					/> 
			</TableRow>
			<TableRow >
				<TextView
					android:id="@+id/aboutUsAppLbl" 
					android:text="@string/app_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:layout_gravity="center"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs1Lbl"
					/> 
			</TableRow>
			<TextView
				android:id="@+id/aboutUsWhatSeparator"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				style="?android:attr/listSeparatorTextViewStyle"
				android:background="#0078c6"
				/>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs2Lbl" 
					android:text="@string/aboutUsLbl2Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:textAppearance="?android:attr/textAppearanceMedium"
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs3Lbl" 
					android:text="@string/aboutUsLbl3Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs2Lbl"
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs4Lbl" 
					android:text="@string/aboutUsLbl4Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs3Lbl"
					android:textAppearance="?android:attr/textAppearanceMedium"
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs5Lbl" 
					android:text="@string/aboutUsLbl5Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs4Lbl"
					/> 
			</TableRow>
			
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs6Lbl" 
					android:text="@string/aboutUsLbl6Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs5Lbl"
					android:textAppearance="?android:attr/textAppearanceMedium"
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs7Lbl" 
					android:text="@string/aboutUsLbl7Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs6Lbl"
					
					/> 
			</TableRow>
			<TextView
				android:id="@+id/aboutUsWho2Separator"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				style="?android:attr/listSeparatorTextViewStyle"
				android:background="#0078c6"
				/>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUs8Lbl" 
					android:text="@string/aboutUsLbl8Txt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUsWho2Separator"
					android:textAppearance="?android:attr/textAppearanceSmall"
					
					/> 
			</TableRow>
			<TableRow>
				<TextView 
					android:id="@+id/aboutUsSubLbl" 
					android:text="@string/aboutUsSubTitleLblTxt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" 
					android:layout_gravity="center"
					android:paddingTop="5dp"
					android:paddingBottom="5dp"
					android:textColor="@color/instWhite"
					android:layout_below="@id/aboutUs5Lbl"
					/> 
			</TableRow>
		</TableLayout>
	
</RelativeLayout>
