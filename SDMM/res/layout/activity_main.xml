<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_layout"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	>
	<LinearLayout
	   	android:id="@+id/home_Ad"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:orientation="vertical"
	    android:layout_alignParentTop="true"
	    />
	<RelativeLayout
	    android:id="@+id/set_default_sms_layout"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
		android:layout_below="@id/home_Ad"
	    >
		<Button
			android:id="@+id/set_default_sms_button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/set_default_sms_button_txt"
			/>
	</RelativeLayout>
	<EditText
		android:id="@+id/send_sms_number_edittext"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/sms_send_number_new_hint"
		android:layout_below="@id/set_default_sms_layout"
		/>            
	<EditText
		android:id="@+id/send_sms_edittext"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/sms_send_new_hint"
		android:layout_below="@id/send_sms_number_edittext"
		/>            
	<Button
		android:id="@+id/send_sms_button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/send_sms_button_txt"
		android:layout_below="@id/send_sms_edittext"
		/>
	<Button
		android:id="@+id/send_sms_intent_button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/send_sms_intent_button_txt"
		android:layout_below="@id/send_sms_button"
		/>
	<ListView 
		android:id="@+id/sms_list"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@id/send_sms_intent_button"
		/>
	<TextView
	    android:id="@+id/sms_empty"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:text="@string/sms_empty_list"
		android:layout_below="@id/send_sms_intent_button"
	    />
</RelativeLayout>
