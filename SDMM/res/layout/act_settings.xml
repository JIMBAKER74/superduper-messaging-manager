<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
	android:background="@color/selectorItemHighlight" 
	>
   	<LinearLayout
       	android:id="@+id/initialScanAppSelectorAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/selectorWarningBackground"
        android:layout_alignParentTop="true"
		>
		<TextView
		    android:id="@+id/initialScanAppSelectorAdBuffer"
	      	android:layout_width="match_parent"
			android:layout_height="30dip"
			/>	    
	    <TextView
			android:id="@+id/initialScanAppSelectorDesc"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorDescTxt"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:gravity="center"
			android:textColor="@color/sdmmWhite"
			android:background="@color/selectorWarningBackground"
			/>
	    <TextView
			android:id="@+id/initialScanAppSelectorFeatureAppsSeperator"
			android:layout_width="match_parent"
			android:layout_height="2dp"
			style="?android:attr/listSeparatorTextViewStyle"
			/>
	</LinearLayout>
   	<RelativeLayout
       	android:id="@+id/initialScanAppSelectorDoneBtnLayout"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:background="@color/selectorWarningBackground"
        android:layout_alignParentBottom="true"
		>
	    <TextView
			android:id="@+id/initialScanAppSelectorDoneBtnSeperator"
			android:layout_width="match_parent"
			android:layout_height="2dp"
			android:layout_alignParentTop="true"
			android:background="@color/selectorItemHighlight" 
			style="?android:attr/listSeparatorTextViewStyle"
			/>
   	    <Button
			android:id="@+id/initialScanAppSelectorDoneBtn"
			android:onClick="setupDone"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorDoneBtnTxt"
			android:layout_alignParentRight="true"
			android:layout_margin="5dip"
			android:padding="5dip"
			android:layout_below="@id/initialScanAppSelectorDoneBtnSeperator"
			/>
   	    <Button
			android:id="@+id/initialScanAppSelectorRescnBtn"
			android:onClick="rescanApps"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Rescan Apps"
			android:layout_alignParentLeft="true"
			android:layout_margin="5dip"
			android:padding="5dip"
			android:layout_below="@id/initialScanAppSelectorDoneBtnSeperator"
			android:layout_toLeftOf="@id/initialScanAppSelectorDoneBtn"
			/>
    </RelativeLayout>
	<ScrollView
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:layout_below="@id/initialScanAppSelectorAd"
	    android:layout_above="@id/initialScanAppSelectorDoneBtnLayout"
	    >
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:background="@color/selectorItemHighlight" 
			>
			<RelativeLayout
				android:id="@+id/initialScanAppSelectorCompatibleAppsLayout"
				android:layout_alignParentTop="true"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/selectorItemBackground"
				android:layout_gravity="center_vertical"
				android:layout_marginTop="3dp"
				>
				<Button
					android:id="@+id/initialScanAppSelectorCompatibleAppsBtn"
					android:onClick="scanCompatibleFullFeaturedAppsView"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/initialScanAppSelectorCompatibleAppsBtnTxt"
					android:layout_margin="10dip"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true"
					android:background="@color/sdmmGreen"
					/>
				<TextView
					android:id="@+id/initialScanAppSelectorCompatibleAppsTitle"
					android:text="@string/initialScanAppSelectorCompatibleAppsTitleTxt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dip"
					android:textAppearance="?android:attr/textAppearanceMedium"
					android:layout_centerVertical="true"
					android:paddingLeft="10dp"
					android:layout_toLeftOf="@id/initialScanAppSelectorCompatibleAppsBtn"
					android:gravity="left"
					android:layout_alignParentLeft="true"
					/>
		    </RelativeLayout>
		    <RelativeLayout
				android:id="@+id/initialScanAppSelectorFeatureAppsLayout"
				android:layout_below="@id/initialScanAppSelectorCompatibleAppsLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/sdmmGray"
				android:layout_gravity="center_vertical"
				android:layout_marginTop="3dp"
				>
				<Button
					android:id="@+id/initialScanAppSelectorFeatureAppsBtn"
					android:onClick="scanNonCompatibleFullFeaturedAppsView"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/initialScanAppSelectorFeatureAppsBtnTxt"
					android:layout_margin="10dip"
					android:layout_centerVertical="true"
					android:layout_alignParentRight="true"
					android:background="@color/sdmmRed2"
					/>
				<TextView
					android:id="@+id/initialScanAppSelectorFeatureAppsTitle"
					android:text="@string/initialScanAppSelectorFeatureAppsTitleTxt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dip"
					android:textAppearance="?android:attr/textAppearanceMedium"
					android:layout_centerVertical="true"
					android:paddingLeft="10dp"
					android:layout_toLeftOf="@id/initialScanAppSelectorFeatureAppsBtn"
					android:gravity="left"
					android:layout_alignParentLeft="true"
					/>
		    </RelativeLayout>
		    <TextView
				android:id="@+id/initialScanAppSelectorCompatibleAppsSeparator"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_below="@id/initialScanAppSelectorFeatureAppsLayout"
				style="?android:attr/listSeparatorTextViewStyle"
				/>
			<RelativeLayout
				android:id="@+id/initialScanAppSelectorShowMoreAppsLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_below="@id/initialScanAppSelectorCompatibleAppsSeparator"
				android:background="@color/selectorItemBackground"
				>
				<TextView
					android:id="@+id/initialScanAppSelectorCompatibleDesc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/initialScanAppSelectorCompatibleDescTxt"
					android:textColor="@color/sdmmWhite"
					android:padding="10sp"
					/>
				<LinearLayout
			        android:id="@+id/initialScanAppSelectorCompatibleAppsIconLayout"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:orientation="horizontal"
			        android:layout_below="@id/initialScanAppSelectorCompatibleDesc"
			        >
				</LinearLayout>
				<TextView
					android:id="@+id/initialScanAppSelectorWarning"
					android:text="@string/initialScanAppSelectorWarningTxt"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_below="@id/initialScanAppSelectorCompatibleAppsIconLayout"
					android:padding="15sp"
					android:layout_centerHorizontal="true"
					android:textAppearance="?android:attr/textAppearanceMedium"
					android:textColor="@color/selectorWarningTextBackground"
					android:background="@color/selectorWarningBackground"
					android:visibility="gone"
					/>
		    </RelativeLayout>
		    <TextView
				android:id="@+id/initialScanAppSelectorShowMoreAppsSeparator"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_below="@id/initialScanAppSelectorShowMoreAppsLayout"
				style="?android:attr/listSeparatorTextViewStyle"
				/>
			<LinearLayout
				android:id="@+id/initialScanAppSelectorMarketLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:layout_alignParentBottom="true"
				android:background="@color/selectorMarketBackground"
				android:orientation="vertical"
				android:layout_below="@id/initialScanAppSelectorShowMoreAppsSeparator"
				>
				<RelativeLayout
			        android:id="@+id/initialScanAppSelectorMarketLayoutDesc"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:layout_gravity="center_vertical"
			        >
					<Button
						android:id="@+id/initialScanAppSelectorMarketBtn"
						android:onClick="compatibleAppsList"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/initialScanAppSelectorSeeMoreBtnTxt"
						android:layout_alignParentRight="true"
						android:layout_margin="5dip"
						android:padding="5dip"
						android:background="@color/selectorMarketSeeMore"
						/>
				    <TextView 
						android:id="@+id/initialScanAppSelectorMarketLbl"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/initialScanAppSelectorRecommendTxt"
						android:textAppearance="?android:attr/textAppearanceMedium"
						android:layout_toLeftOf="@id/initialScanAppSelectorMarketBtn"
						android:layout_alignParentLeft="true"
						android:paddingTop="5sp"
						android:paddingBottom="5sp"
						android:paddingLeft="10sp"
						android:paddingRight="10sp"
						android:textColor="@color/sdmmBlack"
						/>
				</RelativeLayout>
				<LinearLayout
			        android:id="@+id/initialScanAppSelectorMarketAppsLayout"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:orientation="horizontal"
			        >
				</LinearLayout>
		    </LinearLayout>
		</RelativeLayout>
	</ScrollView>
</RelativeLayout>