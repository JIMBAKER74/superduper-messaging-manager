<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
	android:background="@color/sdmmBlue2" 
	>
   	<LinearLayout
       	android:id="@+id/initialScanAppSelectorAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sdmmBgGray"
        android:layout_alignParentTop="true"
		>
		<TextView
		    android:id="@+id/initialScanAppSelectorAdBuffer"
	      	android:layout_width="match_parent"
			android:layout_height="30dip"
			/>	    
		<ImageView 
	   	    android:id="@+id/initialScanAppSelectorProgressBar"
	   	    android:layout_width="match_parent"
	   	    android:layout_height="wrap_content"
	   	    android:src="@drawable/img_set"
	   	    android:background="@color/sdmmBgGray"
	   	    />
		<TextView
			android:id="@+id/initialScanAppSelectorDesc"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorTitleTxt"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:gravity="center"
			android:textColor="@color/sdmmWhite"
			android:background="@color/selectorWarningBackground"
			android:layout_margin="10dp"
			/>
	    <TextView
			android:id="@+id/initialScanAppSelectorFeatureAppsSeperator"
			android:layout_width="match_parent"
			android:layout_height="2dp"
			style="?android:attr/listSeparatorTextViewStyle"
			/>
	</LinearLayout>
   	<RelativeLayout
       	android:id="@+id/initialScanAppSelectorDoneBtnLayout"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:background="@color/sdmmWhite"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="3dp"
		>
	    <TextView
			android:id="@+id/initialScanAppSelectorDoneBtnSeperator"
			android:layout_width="match_parent"
			android:layout_height="2dp"
			android:layout_alignParentTop="true"
			android:background="@color/selectorItemHighlight" 
			style="?android:attr/listSeparatorTextViewStyle"
			/>
   	    <Button
			android:id="@+id/initialScanAppSelectorDoneBtn"
			android:onClick="setupDone"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorNextBtnTxt"
			android:layout_alignParentRight="true"
			android:layout_margin="5dip"
			android:padding="5dip"
			android:layout_below="@id/initialScanAppSelectorDoneBtnSeperator"
			/>
		<Button
			android:id="@+id/initialScanAppSelectorSetDefaultBtn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorSetDefaultBtnTxt"
			android:textColor="@color/sdmmWhite"
			android:layout_margin="5sp"
			android:padding="15sp"
			android:layout_centerVertical="true"
			android:layout_alignParentLeft="true"
			android:onClick="setupDefault"
			android:layout_toLeftOf="@id/initialScanAppSelectorDoneBtn"
			android:layout_below="@id/initialScanAppSelectorDoneBtnSeperator"
			/>
   	    <TextView 
			android:id="@+id/initialScanAppSelectorDoneLbl"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialScanAppSelectorDoneLblTxt"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:layout_toLeftOf="@id/initialScanAppSelectorDoneBtn"
			android:layout_below="@id/initialScanAppSelectorDoneBtnSeperator"
			android:layout_alignParentLeft="true"
			android:paddingLeft="10sp"
			android:paddingRight="10sp"
			android:textColor="@color/sdmmWhite"
			/>
    </RelativeLayout>
	<ScrollView
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:layout_below="@id/initialScanAppSelectorAd"
	    android:layout_above="@id/initialScanAppSelectorDoneBtnLayout"
	    android:background="@color/sdmmBgGray"
	    >
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:background="@color/selectorItemHighlight" 
			>
			<RelativeLayout
				android:id="@+id/initialScanAppSelectorShowAppsMsgLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/selectorItemBackground"
				>
				<TextView
					android:id="@+id/initialScanAppSelectorCompatibleDesc"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/initialScanAppSelectorDescrTxt"
					android:textColor="@color/sdmmWhite"
					android:padding="10sp"
					/>
			</RelativeLayout>
			<RelativeLayout
				android:id="@+id/initialScanAppSelectorShowMoreAppsLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/selectorItemBackground"
				android:layout_below="@id/initialScanAppSelectorShowAppsMsgLayout"
				>
				<TextView
					android:id="@+id/initialScanAppSelectorNotDefaultWarningDesc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/initialScanAppSelectorNotDefaultWarningDescTxt"
					android:textColor="@color/sdmmRed"
					android:padding="10sp"
					android:gravity="center"
					android:visibility="gone"
					/>
				<LinearLayout
			        android:id="@+id/initialScanAppSelectorCompatibleAppsIconLayout"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:orientation="horizontal"
			        android:layout_below="@id/initialScanAppSelectorNotDefaultWarningDesc"
			        >
				</LinearLayout>
		    </RelativeLayout>
		    <TextView
				android:id="@+id/initialScanAppSelectorShowMoreAppsSeparator"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_below="@id/initialScanAppSelectorShowMoreAppsLayout"
				style="?android:attr/listSeparatorTextViewStyle"
				/>
			<LinearLayout
				android:id="@+id/initialScanAppSelectorMarketLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:layout_alignParentBottom="true"
				android:background="@color/selectorMarketBackground"
				android:orientation="vertical"
				android:layout_below="@id/initialScanAppSelectorShowMoreAppsSeparator"
				>
				<RelativeLayout
			        android:id="@+id/initialScanAppSelectorMarketLayoutDesc"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:layout_gravity="center_vertical"
			        >
					<Button
						android:id="@+id/initialScanAppSelectorMarketBtn"
						android:onClick="compatibleAppsList"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/initialScanAppSelectorSeeMoreBtnTxt"
						android:layout_alignParentRight="true"
						android:layout_margin="5dip"
						android:padding="5dip"
						android:background="@color/selectorMarketSeeMore"
						/>
				    <TextView 
						android:id="@+id/initialScanAppSelectorMarketLbl"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/initialScanAppSelectorRecommendTxt"
						android:textAppearance="?android:attr/textAppearanceMedium"
						android:layout_toLeftOf="@id/initialScanAppSelectorMarketBtn"
						android:layout_alignParentLeft="true"
						android:paddingTop="5sp"
						android:paddingBottom="5sp"
						android:paddingLeft="10sp"
						android:paddingRight="10sp"
						android:textColor="@color/sdmmBlack"
						/>
				</RelativeLayout>
				<LinearLayout
			        android:id="@+id/initialScanAppSelectorMarketAppsLayout"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:orientation="horizontal"
			        >
				</LinearLayout>
		    </LinearLayout>
		</RelativeLayout>
	</ScrollView>
</RelativeLayout>