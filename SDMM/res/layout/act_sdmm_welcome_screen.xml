<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/instBlack"
    >
	<RelativeLayout
		android:id="@+id/welcomeBorder"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_centerInParent="true"
		android:background="#ffffff"
		android:layout_marginLeft="5dp"
		android:layout_marginRight="5dp"
		android:layout_marginTop="5dp"
		android:layout_marginBottom="5dp"
	    android:layout_above="@+id/welcomePrivacyOptionsLayout"
		> 
		<LinearLayout
			android:id="@+id/welcomeScreenLayout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_centerInParent="true"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginBottom="5dp"
			android:background="@drawable/bg_home"
			android:orientation="vertical"
			> 
			<TextView 
				android:id="@+id/welcomeTitleCommentsLbl" 
				android:text="@string/welcomeCommentsLblTxt"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" 
				android:padding="10dp"
				android:gravity="center"
				android:textAppearance="?android:attr/textAppearanceLarge"
				android:background="@android:color/transparent"
				android:textColor="@color/instWhite"
				/> 
			
			<ImageView 
				android:id="@+id/welcomeCommentsLbl" 
				android:src="@drawable/img_icon_lg"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" 
				android:padding="10dp"
				android:layout_gravity="center"
				android:background="@android:color/transparent"
				/> 
		
			 
		</LinearLayout>
		<LinearLayout
		    android:id="@id/welcomePrivacyOptionsLayout"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:gravity="center"
			android:background="@android:color/transparent"
			android:layout_alignParentBottom="true"
			android:layout_marginBottom="15dp"
			>
			<Button 
				android:id="@+id/welcomeTermsLinkLbl" 
				android:text="@string/welcomeTermsLinkLblTxt"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" 
				android:layout_margin="10dp"
				android:padding="5dp"
				android:layout_gravity="center"
				android:textAppearance="?android:attr/textAppearanceMedium"
				android:background="@android:color/transparent"
				android:textColor="@android:color/holo_blue_light"
				android:onClick="viewTerms"
				/>
		    <CheckBox
				android:id="@+id/welcomePrivacyAcceptChk"
				android:text="@string/privacyAcceptTermsChkTxt"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" 
				android:textSize="16dp"
				android:layout_marginTop="5dip"
				android:onClick="termsCheck"
				android:textColor="@color/instWhite"
				/>
			<LinearLayout
	            android:id="@+id/welcomePrivacyButtonsLayout"
	            android:layout_width="fill_parent"
	            android:layout_height="wrap_content"
	            android:orientation="horizontal"
	            android:gravity="center"
	            android:layout_marginTop="5dp"
	            >
		        <Button 
		            android:id="@+id/welcomePrivacyAcceptBtn"
	                android:layout_width="wrap_content"
	                android:layout_height="48dp"
	                android:maxLines="2"
	                android:minWidth="50dip"
	                android:maxHeight="48dp"
	                android:text="@string/privacyAcceptBtnTxt"
					android:background="@color/selectorItemBackground"
	                android:gravity="center"
					android:onClick="initialScan"
					android:paddingLeft="15sp"
					android:paddingRight="15sp"
	                />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
