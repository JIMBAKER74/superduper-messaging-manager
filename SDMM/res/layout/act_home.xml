<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/homeMainScrollLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/sdmmBgGray"
	android:fillViewport="true"
	>
	<RelativeLayout 
	    android:id="@+id/homeMainLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		>
		<RelativeLayout 
		    android:id="@+id/homeTopContentLayoutContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
			>
			<ImageView 
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_home"
				android:adjustViewBounds="true"
				android:scaleType="fitCenter"
				android:layout_alignTop="@+id/homecontentLayout"
				android:layout_alignBottom="@id/homecontentLayout"
			    />
		    <LinearLayout
	            android:id="@id/homecontentLayout"
	            android:layout_width="match_parent"
	            android:layout_height="wrap_content"
	            android:orientation="vertical"
	            android:layout_alignParentTop="true"
	            >
		        <LinearLayout
		           	android:id="@+id/homeAd"
		   	        android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:orientation="vertical"
		       	    />
		        <TextView
		            android:id="@+id/homeHeaderTxt"
		   	        android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:text="@string/homeHeaderTxtStr"
		            android:layout_marginLeft="30dp"
		            android:layout_marginRight="30dp"
		            android:layout_marginTop="30dp"
		            android:gravity="center_horizontal"
					android:textAppearance="?android:attr/textAppearanceSmall"
		            />
		        <TextView
		            android:id="@+id/homeTitleTxt"
		   	        android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:text="@string/homeTitleTxtStr"
		            android:layout_margin="30dp"
		            android:gravity="center_horizontal"
					android:textAppearance="?android:attr/textAppearanceLarge"
		            />
				<Button
		           	android:id="@+id/homeAppsBtn"
		   	        android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:onClick="viewApps"
		            android:text="@string/homeViewAppsStr"
		            android:layout_marginLeft="20dp"
		            android:layout_marginRight="20dp"
		       	    />
				<Button
		           	android:id="@+id/homeSettingsBtn"
		   	        android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:onClick="viewSettings"
		            android:text="@string/homeViewSettingsStr"
		            android:layout_marginTop="10dp"
		            android:layout_marginLeft="20dp"
		            android:layout_marginRight="20dp"
		            android:layout_marginBottom="30dp"
		       	    />
			</LinearLayout>
		</RelativeLayout>
		<RelativeLayout 
		    android:id="@+id/homeLauncherBottomLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_below="@id/homeTopContentLayoutContainer"
			>
	    	<TextView
				android:id="@+id/homeLauncherInstructions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/welcomeIconHelp"
				android:textColor="@color/sdmmWhite"
				android:gravity="center"
				android:paddingBottom="5dp"
				android:paddingTop="5dp"
				android:background="@color/sdmmBgGray"
				android:textAppearance="?android:attr/textAppearanceSmall"
				/>
			<LinearLayout
				android:id="@+id/homeAppSelectorLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:background="@color/sdmmBgGray"
				android:orientation="vertical"
				android:layout_below="@id/homeLauncherInstructions"
				>
			</LinearLayout>
			<TextView
				android:id="@+id/homeAppSelectorWarning"
				android:text="@string/homeAppSelectorWarningTxt"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_below="@id/homeAppSelectorLayout"
				android:padding="15sp"
				android:layout_centerHorizontal="true"
				android:textAppearance="?android:attr/textAppearanceMedium"
				android:textColor="@color/selectorWarningTextBackground"
				android:background="@color/selectorWarningBackground"
				android:visibility="gone"
				/>
		    <TextView
				android:id="@+id/homeAppSelectorShowMoreAppsSeparator"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_below="@id/homeAppSelectorWarning"
				style="?android:attr/listSeparatorTextViewStyle"
				/>
			<LinearLayout
				android:id="@+id/homeAppSelectorMarketLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:background="@color/selectorMarketBackground"
				android:orientation="vertical"
				android:layout_below="@id/homeAppSelectorShowMoreAppsSeparator"
				>
				<RelativeLayout
			        android:id="@+id/homeAppSelectorMarketLayoutDesc"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:layout_gravity="center_vertical"
			        >
					<Button
						android:id="@+id/homeAppSelectorMarketBtn"
						android:onClick="compatibleAppsList"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/homeAppSelectorSeeMoreBtnTxt"
						android:layout_alignParentRight="true"
						android:layout_margin="5dip"
						android:padding="5dip"
						android:background="@color/selectorMarketSeeMore"
						/>
				    <TextView 
						android:id="@+id/homeAppSelectorMarketLbl"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/homeAppSelectorRecommendTxt"
						android:textAppearance="?android:attr/textAppearanceMedium"
						android:layout_toLeftOf="@id/homeAppSelectorMarketBtn"
						android:layout_alignParentLeft="true"
						android:paddingTop="5sp"
						android:paddingBottom="5sp"
						android:paddingLeft="10sp"
						android:paddingRight="10sp"
						android:textColor="@color/sdmmBlack"
						/>
				</RelativeLayout>
				<LinearLayout
			        android:id="@+id/homeAppSelectorMarketAppsLayout"
			        android:layout_width="match_parent"
			        android:layout_height="wrap_content"
			        android:orientation="horizontal"
			        >
				</LinearLayout>
		    </LinearLayout>
		</RelativeLayout>
	</RelativeLayout>
</ScrollView>