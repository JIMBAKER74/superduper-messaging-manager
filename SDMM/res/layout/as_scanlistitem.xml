<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:padding="10sp"
        android:layout_margin="5sp"
        >
	<LinearLayout
		android:id="@+id/scanListItemMarkBtnLayout"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_alignParentRight="true"
		android:gravity="center_horizontal"
		>
	    <Button
			android:id="@+id/scanListItemMarkSafeBtn"
			android:text="@string/scanListItemMarkSafeBtnTxt"
			android:contentDescription="@string/scanListItemMarkSafeBtnTxt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="3dip"
			android:layout_marginRight="3dip"
			android:gravity="center"
			android:textColor="@color/instWhite"
			android:background="@drawable/scanlist_marksafe_btn"
			android:layout_weight="1.0"
	        />
		<Button
	        android:id="@+id/scanListItemMarkIdkBtn"
	        android:text="@string/scanListItemMarkIdkBtnTxt"
			android:contentDescription="@string/scanListItemMarkIdkBtnTxt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_margin="3dip"
			android:gravity="center"
			android:textColor="@color/instWhite"
			android:background="@drawable/scanlist_markwatch_btn"
			android:layout_weight="1.0"
			/>
	    <Button
			android:id="@+id/scanListItemMarkUnsafeBtn"
			android:text="@string/scanListItemMarkUnsafeBtnTxt"
			android:contentDescription="@string/scanListItemMarkUnsafeBtnTxt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_margin="3dip"
			android:gravity="center"
			android:textColor="@color/instWhite"
			android:background="@drawable/scanlist_markunsafe_btn"
			android:layout_weight="1.0"
			/>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/scanItemInstallBtnLayout"
		android:layout_toLeftOf="@id/scanListItemMarkBtnLayout"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:gravity="center"
		>
		<Button
			android:id="@+id/scanListItemViewInfoBtn"
			android:text="@string/scanListItemViewBtnTxt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			/>
		<Button
			android:id="@+id/scanListItemUninstallBtn"
			android:text="@string/scanListItemUninstallTxt"
			android:contentDescription="@string/scanListItemUninstallTxt"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_margin="3dip"
			android:gravity="center"
			android:textColor="@color/instWhite"
			android:background="@drawable/scanlist_uninstall_btn"
			android:layout_weight="1.0"
			/>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/scanItemViewInfoLayout"
        android:layout_toLeftOf="@id/scanItemInstallBtnLayout"
		android:layout_alignParentLeft="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		>
        <TextView
			android:id="@+id/scanListItemTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/sdmmWhite"
			android:textColorHint="@color/sdmmWhite"
			android:textAppearance="?android:attr/textAppearanceLarge"
			/>
        <TextView
			android:id="@+id/scanListItemDescr"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/sdmmWhite"
			android:textColorHint="@color/sdmmWhite"
			android:textAppearance="?android:attr/textAppearanceSmall"
			/>
    </LinearLayout>
</RelativeLayout>
