<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/appSelectorCompatibleAppsBackground"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:background="@color/selectorItemHighlight"
	>
    <ImageView 
	    android:id="@+id/appSelectorGooglePlayIcon"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerHorizontal="true"
		android:background="@color/selectorItemBackground"
		android:visibility="gone"
		/>
    <ImageView 
	    android:id="@+id/appSelectorCompatibleIcon"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:paddingLeft="20sp"
		android:paddingRight="20sp"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="5dp"
		android:layout_marginLeft="5dp"
		android:layout_marginRight="5dp"
		android:background="@color/selectorItemBackground"
		android:layout_below="@id/appSelectorGooglePlayIcon"
		/>
	<TextView
		android:id="@+id/appSelectorCompatibleDesc"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@id/appSelectorCompatibleIcon"
		android:text="@string/initialScanAppSelectorCompatibleDescTxt"
		android:textColor="@color/sdmmWhite"
		android:padding="5dp"
		android:layout_marginBottom="5dp"
		android:background="@color/selectorItemBackground"
		android:layout_centerHorizontal="true"
		android:gravity="center"
		android:layout_alignLeft="@id/appSelectorCompatibleIcon"
		android:layout_alignRight="@id/appSelectorCompatibleIcon"
		android:textAppearance="?android:attr/textAppearanceSmall"
		/>
</RelativeLayout>