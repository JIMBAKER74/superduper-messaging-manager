<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_gravity="center_horizontal"
	android:background="#0078c6" 
	>
   	<LinearLayout
       	android:id="@+id/initialScanAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:orientation="vertical"
		/>
	<TextView
		android:id="@+id/initialScanBuffer"
		android:layout_width="match_parent"
		android:layout_height="30dip"
		/>	    
    <RelativeLayout
		android:id="@+id/initialScanLayout"
		android:layout_below="@id/initialScanAd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginTop="3dp"
		android:layout_marginBottom="3dp"
		android:background="#333333"
		>
        <LinearLayout
			android:id="@+id/initialScanBtnLayout"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
			android:layout_alignParentRight="true"
			android:orientation="horizontal"
			>
            <Button
                android:id="@+id/initialScanBtn"
                android:onClick="scanNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initialScanBtnTxt"
                android:layout_marginTop="10dip"
                android:layout_marginBottom="10dip"
                />
	        <ProgressBar
	            android:id="@+id/initialScanProgressSpinner"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
	            />
	    </LinearLayout>
        <LinearLayout
            android:id="@+id/initialScanDescrLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/initialScanBtnLayout"
            android:gravity="left|center_vertical"
            android:layout_alignParentLeft="true"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/initialScanTitle"
                android:text="@string/initialScanTitleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:layout_marginTop="10dip"
                android:textAppearance="?android:attr/textAppearanceLarge"
                />
            <TextView
                android:id="@+id/initialScanDescr"
                android:text="@string/initialScanDescrTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                />
		</LinearLayout>
        <ProgressBar
            android:id="@+id/initialScanProgress"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:layout_below="@id/initialScanDescrLayout"
			android:paddingTop="10dp"
			android:paddingRight="15dp"
			android:paddingLeft="15dp"
			style="@android:style/Widget.ProgressBar.Horizontal"
            />
		<TextView
	        android:id="@+id/initialScanProgressDescr"
	        android:text="@string/viewAppsScanProgressDescrTxt"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:paddingBottom="10dp"
			android:layout_gravity="center"
			android:layout_centerInParent="true"
			android:layout_below="@id/initialScanProgress"
	        android:textAppearance="?android:attr/textAppearanceSmall"
	        />
    </RelativeLayout>
    <TextView
		android:id="@+id/initialScanSeparator"
		android:layout_width="match_parent"
		android:layout_height="2dp"
		android:layout_below="@id/initialScanLayout"
		style="?android:attr/listSeparatorTextViewStyle"
		/>
    <RelativeLayout
        android:id="@+id/initialScanViewStartLayout"
		android:layout_below="@id/initialScanSeparator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:layout_gravity="center_vertical"
        >
		<TextView
			android:id="@+id/initialScanViewStartTitle"
			android:text="@string/initialScanViewStartTitleTxt"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dip"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:gravity="center"
			android:paddingLeft ="10dp"
			android:paddingRight ="10dp"
			android:layout_alignParentTop="true"
			android:layout_alignParentLeft="true"
			/>
		<TextView
			android:id="@+id/initialScanViewStartDescr"
			android:text="@string/initialScanViewStartDescrTxt"
			android:layout_width="wrap_content"
			android:layout_height="fill_parent"
			android:layout_marginBottom="10dip"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:layout_centerVertical="true"
			android:padding="10dp"
			android:layout_below="@id/initialScanViewStartTitle"
			android:layout_alignParentLeft="true"
			/>
    </RelativeLayout>
    <RelativeLayout 
        android:id="@+id/initialScanViewResultsAppsLayout"
		android:layout_below="@id/initialScanViewStartLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
        >
	    <RelativeLayout
	        android:id="@+id/initialScanViewNonMessagingAppsLayout"
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:background="#555555"
	        android:layout_gravity="center_vertical"
	        android:paddingTop="10dp"
	        android:paddingBottom="10dp"
	        >
	        <Button
				android:id="@+id/initialScanViewNonMessagingAppsBtn"
				android:onClick="scanSafeView"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/initialScanViewNonMessagingAppsBtnTxt"
				android:layout_margin="5dip"
				android:padding="10dp"
				android:layout_alignParentRight="true"
				android:background="#aa43a746"
				/>
	        <TextView
	            android:id="@+id/initialScanViewNonMessagingAppsTitle"
	            android:text="@string/initialScanViewNonMessagingAppsTitleTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_centerVertical="true"
	            android:textAppearance="?android:attr/textAppearanceMedium"
	            android:layout_marginTop="10dip"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewNonMessagingAppsBtn"
	            android:layout_alignParentTop="true"
	            android:layout_alignParentLeft="true"
                />
            <TextView
	            android:id="@+id/initialScanViewNonMessagingAppsDescr"
	            android:text="@string/initialScanViewNonMessagingAppsDescrTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_marginBottom="10dip"
	            android:textAppearance="?android:attr/textAppearanceSmall"
	            android:layout_centerVertical="true"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewNonMessagingAppsBtn"
	            android:layout_below="@id/initialScanViewNonMessagingAppsTitle"
	            android:layout_alignParentLeft="true"
	            />
	    </RelativeLayout>
	    <TextView
	        android:id="@+id/initialScanViewMessagingAppsSeparator"
	        android:layout_width="match_parent"
	        android:layout_height="2dp"
	        android:layout_below="@id/initialScanViewNonMessagingAppsLayout"
	        style="?android:attr/listSeparatorTextViewStyle"
	        />
	    <RelativeLayout
	        android:id="@+id/initialScanViewMessagingAppsLayout"
	        android:layout_below="@id/initialScanViewMessagingAppsSeparator"
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:background="#777777"
	        android:layout_gravity="center_vertical"
	        android:layout_marginTop="3dp"
	        android:paddingTop="10dp"
	        android:paddingBottom="10dp"
	        >
            <Button
	            android:id="@+id/initialScanViewMessagingAppsBtn"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:text="@string/initialScanViewMessagingAppsBtnTxt"
				android:layout_margin="5dip"
				android:padding="10dp"
	            android:layout_alignParentRight="true"
	            android:background="#aa0078c6"
	            />
            <TextView
	            android:id="@+id/initialScanViewMessagingAppsTitle"
	            android:text="@string/initialScanViewMessagingAppsTitleTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_marginTop="10dip"
	            android:textAppearance="?android:attr/textAppearanceMedium"
	            android:layout_centerVertical="true"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewMessagingAppsBtn"
	            android:layout_alignParentTop="true"
	            android:layout_alignParentLeft="true"
	            />
            <TextView
	            android:id="@+id/initialScanViewMessagingAppsDescr"
	            android:text="@string/initialScanViewMessagingAppsDescrTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_marginBottom="10dip"
	            android:textAppearance="?android:attr/textAppearanceSmall"
	            android:layout_centerVertical="true"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewMessagingAppsBtn"
	            android:layout_below="@id/initialScanViewMessagingAppsTitle"
	            android:layout_alignParentLeft="true"
	            />
	    </RelativeLayout>
	    <TextView
	        android:id="@+id/initialScanViewDefaultMessagingAppsSeparator"
	        android:layout_width="match_parent"
	        android:layout_height="2dp"
	        android:layout_below="@id/initialScanViewMessagingAppsLayout"
	        style="?android:attr/listSeparatorTextViewStyle"
	        />
	    <RelativeLayout
	        android:id="@+id/initialScanViewDefaultMessagingAppsLayout"
	        android:layout_below="@id/initialScanViewDefaultMessagingAppsSeparator"
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:background="#555555"
	        android:layout_gravity="center_vertical"
	        android:layout_marginTop="3dp"
	        android:paddingTop="10dp"
	        android:paddingBottom="10dp"
	        >
            <Button
	            android:id="@+id/initialScanViewDefaultMessagingAppsBtn"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:text="@string/initialScanViewMessagingAppsBtnTxt"
				android:layout_margin="5dip"
				android:padding="10dp"
	            android:layout_alignParentRight="true"
	            android:background="#aafae134"
	            />
            <TextView
	            android:id="@+id/initialScanViewDefaultMessagingAppsTitle"
	            android:text="@string/initialScanViewDefaultMessagingAppsTitleTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_marginTop="10dip"
	            android:textAppearance="?android:attr/textAppearanceMedium"
	            android:layout_centerVertical="true"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewDefaultMessagingAppsBtn"
	            android:layout_alignParentTop="true"
	            android:layout_alignParentLeft="true"
	            />
            <TextView
	            android:id="@+id/initialScanViewDefaultMessagingAppsDescr"
	            android:text="@string/initialScanViewDefaultMessagingAppsDescrTxt"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_marginBottom="10dip"
	            android:textAppearance="?android:attr/textAppearanceSmall"
	            android:layout_centerVertical="true"
	            android:paddingLeft="10dp"
	            android:layout_toLeftOf="@id/initialScanViewDefaultMessagingAppsBtn"
	            android:layout_below="@id/initialScanViewDefaultMessagingAppsTitle"
	            android:layout_alignParentLeft="true"
	            />
	    </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
	        android:id="@+id/initialScanViewMessagingNextBtnLayout"
	        android:layout_below="@id/initialScanViewResultsAppsLayout"
	        android:layout_width="match_parent"
	        android:layout_height="fill_parent"
	        android:background="#333333"
	        android:layout_gravity="center_vertical"
	        android:layout_marginTop="3dp"
	        >
		    <Button
				android:id="@+id/initialScanViewNextBtn"
				android:onClick="viewInitialAppSelector"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/initialScanViewNextBtnTxt"
				android:paddingRight="25dip"
				android:paddingLeft="25dip"
				android:layout_marginTop="15dip"
				android:layout_marginBottom="10dip"
				android:layout_centerHorizontal="true"
				/>
    </RelativeLayout>
</RelativeLayout>
