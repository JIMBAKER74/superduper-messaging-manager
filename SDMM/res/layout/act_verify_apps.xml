<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
	android:background="@color/selectorItemHighlight" 
	>
   	<LinearLayout
       	android:id="@+id/verifyAppsAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
   	    android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/selectorWarningBackground"
		/>
   	<ImageView 
   	    android:id="@+id/verifyAppsProgressBar"
   	    android:layout_width="match_parent"
   	    android:layout_height="wrap_content"
   	    android:layout_below="@id/verifyAppsAd"
   	    android:src="@drawable/img_verify"
   	    android:layout_centerHorizontal="true"
   	    android:background="@color/sdmmBgGray"
   	    />
    <RelativeLayout
		android:id="@+id/verifyAppsLayout"
		android:layout_below="@id/verifyAppsProgressBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginBottom="2dp"
		android:background="@color/sdmmBgGray"
		>
        <LinearLayout
            android:id="@+id/verifyAppsDescrLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
            android:gravity="left|center_vertical"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/verifyAppsTitle"
                android:text="@string/verifyAppsTitleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:layout_margin="5dip"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/verifyAppsDescr"
                android:text="@string/verifyAppsDescrTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                />
		    <Button
				android:id="@+id/verifyAppsBtn"
				android:onClick="verifyBtn"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/verifyAppsVerifyBtnTxt"
				android:layout_gravity="right"
				/>
		</LinearLayout>
    </RelativeLayout>
    <LinearLayout 
        android:id="@+id/verifyAppsViewResultsAppsLayout"
		android:layout_below="@id/verifyAppsLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:orientation="vertical"
        android:background="@color/sdmmBgGray"
        />
	<RelativeLayout
        android:id="@+id/verifyAppsViewMessagingNextBtnLayout"
        android:layout_below="@id/verifyAppsViewResultsAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:background="@color/sdmmBgGray"
        android:layout_gravity="center_vertical"
        >
	    <Button
			android:id="@+id/verifyAppsViewNextBtn"
			android:onClick="nextBtn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/verifyAppsViewNextBtnTxt"
			android:paddingRight="25dip"
			android:paddingLeft="25dip"
			android:layout_marginTop="15dip"
			android:layout_marginBottom="10dip"
			android:layout_centerHorizontal="true"
			/>
    </RelativeLayout>
</RelativeLayout>
