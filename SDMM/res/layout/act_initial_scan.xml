<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/selectorItemHighlight" 
	>
	<ImageView 
   	    android:id="@+id/initialScanProgressBar"
   	    android:layout_width="match_parent"
   	    android:layout_height="wrap_content"
   	    android:src="@drawable/img_scan"
   	    android:layout_centerHorizontal="true"
   	    android:layout_alignParentTop="true"
   	    android:background="@color/sdmmBgGray"
   	    />
   	<LinearLayout
       	android:id="@+id/initialScanAd"
        android:layout_width="match_parent"
		android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/selectorWarningBackground"
        android:layout_below="@id/initialScanProgressBar"
		/>
    <RelativeLayout
		android:id="@+id/initialScanLayout"
		android:layout_below="@id/initialScanAd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginBottom="2dp"
		android:background="@color/sdmmBgGray"
		>
        <LinearLayout
			android:id="@+id/initialScanBtnLayout"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:orientation="horizontal"
			>
            <Button
                android:id="@+id/initialScanBtn"
                android:onClick="scanNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initialScanBtnTxt"
                android:layout_marginTop="10dip"
                android:layout_marginBottom="10dip"
                />
	        <ProgressBar
	            android:id="@+id/initialScanProgressSpinner"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:layout_margin="10dp"
	            />
	    </LinearLayout>
        <LinearLayout
            android:id="@+id/initialScanDescrLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/initialScanBtnLayout"
            android:gravity="left|center_vertical"
            android:layout_alignParentLeft="true"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/initialScanTitle"
                android:text="@string/initialScanTitleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:layout_marginTop="10dip"
                android:textAppearance="?android:attr/textAppearanceLarge"
                />
            <TextView
                android:id="@+id/initialScanDescr"
                android:text="@string/initialScanDescrTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
				android:paddingLeft ="10dp"
				android:paddingRight ="10dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                />
		</LinearLayout>
        <ProgressBar
            android:id="@+id/initialScanProgress"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:layout_below="@id/initialScanDescrLayout"
			android:paddingTop="10dp"
			android:paddingRight="15dp"
			android:paddingLeft="15dp"
			style="@android:style/Widget.ProgressBar.Horizontal"
            />
		<TextView
	        android:id="@+id/initialScanProgressDescr"
	        android:text="@string/viewAppsScanProgressDescrTxt"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:paddingBottom="10dp"
			android:layout_gravity="center"
			android:layout_centerInParent="true"
			android:layout_below="@id/initialScanProgress"
	        android:textAppearance="?android:attr/textAppearanceSmall"
	        />
    </RelativeLayout>
    <TextView
		android:id="@+id/initialScanSeparator"
		android:layout_width="match_parent"
		android:layout_height="2dp"
		android:layout_below="@id/initialScanLayout"
		style="?android:attr/listSeparatorTextViewStyle"
		/>
    <RelativeLayout
        android:id="@+id/initialScanViewMessagingNextBtnLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sdmmBgGray"
        android:layout_marginTop="3dp"
        android:layout_alignParentBottom="true"
        >
	    <Button
			android:id="@+id/initialScanViewNextBtn"
			android:onClick="viewInitialAppSelector"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/initialScanViewNextBtnTxt"
			android:paddingRight="25dip"
			android:paddingLeft="25dip"
			android:layout_marginTop="15dip"
			android:layout_marginBottom="10dip"
			android:layout_centerHorizontal="true"
			/>
    </RelativeLayout>
    <ScrollView
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
		android:layout_below="@id/initialScanSeparator"
		android:layout_above="@id/initialScanViewMessagingNextBtnLayout"
		android:background="@color/sdmmBgGray"
	    >
	    <LinearLayout
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:background="@color/sdmmBgGray"
	        android:orientation="vertical"
	        >
		    <RelativeLayout
		        android:id="@+id/initialScanViewStartLayout"
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content"
		        android:background="@color/sdmmBgGray"
		        android:layout_gravity="center_vertical"
		        >
				<TextView
					android:id="@+id/initialScanViewStartTitle"
					android:text="@string/initialScanViewStartTitleTxt"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dip"
					android:textAppearance="?android:attr/textAppearanceMedium"
					android:gravity="center"
					android:paddingLeft ="10dp"
					android:paddingRight ="10dp"
					android:layout_alignParentTop="true"
					android:layout_alignParentLeft="true"
					/>
				<TextView
					android:id="@+id/initialScanViewStartDescr"
					android:text="@string/initialScanViewStartDescrTxt"
					android:layout_width="wrap_content"
					android:layout_height="fill_parent"
					android:layout_marginBottom="10dip"
					android:textAppearance="?android:attr/textAppearanceSmall"
					android:layout_centerVertical="true"
					android:padding="10dp"
					android:layout_below="@id/initialScanViewStartTitle"
					android:layout_alignParentLeft="true"
					/>
		    </RelativeLayout>
		    <LinearLayout 
		        android:id="@+id/initialScanViewResultsAppsLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
		        />
		</LinearLayout>
	</ScrollView>
</RelativeLayout>
