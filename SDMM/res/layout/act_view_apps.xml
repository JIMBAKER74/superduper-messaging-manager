<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_gravity="center_horizontal"
	android:background="@drawable/bg_home"
	>
	<LinearLayout
		android:id="@+id/viewAppsAd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		>
		<TextView
			android:id="@+id/viewAppsAdBuffer"
			android:layout_width="match_parent"
			android:layout_height="30dip"
			/>
	</LinearLayout>   
    <TextView
		android:id="@+id/viewAppsSeparator"
		android:layout_width="match_parent"
		android:layout_height="2dp"
		android:layout_below="@id/viewAppsAd"
		style="?android:attr/listSeparatorTextViewStyle"
		/>
    <TextView
		android:id="@+id/viewAppsCategoryTitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/viewAppsCategoryTitleTxt"
		android:textColor="@android:color/white"
		android:textAppearance="?android:attr/textAppearanceLarge"
		android:gravity="center"
		android:background="@color/sdmmBlue2"
		android:layout_below="@id/viewAppsSeparator"
		/>
	<ScrollView
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:layout_below="@id/viewAppsCategoryTitle"
	    android:layout_alignParentBottom="true"
	    >
    	<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:background="@drawable/bg_home"
			>
		    <RelativeLayout
		            android:id="@+id/viewAppsLayout"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        <LinearLayout
		                android:id="@+id/viewAppsFullBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsFullBtn"
		                    android:onClick="viewCompatibleSMSApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewSafeAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
		            android:id="@+id/viewAppsFullIcon"
		            android:layout_width="wrap_content"
		            android:layout_height="wrap_content"
		            android:src="@drawable/img_full_featured"
		            android:background="@android:color/transparent"
		            android:layout_centerVertical="true"
		            android:padding="5dp"
		            />
		        <LinearLayout
		            	android:id="@+id/viewAppsFullLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsFullIcon"
		                android:layout_toLeftOf="@id/viewAppsFullBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsFullTitle"
		                    android:text="@string/viewAppsFullTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsFullDescr"
		                    android:text="@string/viewAppsFullDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		    <TextView
		            android:id="@+id/viewAppsAntispamSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="2dp"
		            android:layout_below="@id/viewAppsLayout"
		            style="?android:attr/listSeparatorTextViewStyle"
		            android:background="@color/sdmmBlue2"
		            />
		    <RelativeLayout
		            android:id="@+id/viewAppsAntispamLayout"
		            android:layout_below="@id/viewAppsAntispamSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        
		        <LinearLayout
		                android:id="@+id/viewAppsAntispamBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsAntispamBtn"
		                    android:onClick="viewSecondarySMSApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewUnknownAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
			            android:id="@+id/viewAppsAntispamIcon"
			            android:layout_width="wrap_content"
			            android:layout_height="wrap_content"
			            android:src="@drawable/img_antispam"
			            android:background="@android:color/transparent"
			            android:layout_centerVertical="true"
			            android:padding="5dp"
			            />
		        <LinearLayout
		                android:id="@+id/viewAppsAntispamDescrLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsAntispamIcon"
		                android:layout_toLeftOf="@id/viewAppsAntispamBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsAntispamAppsTitle"
		                    android:text="@string/viewAppsAntispamAppsTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsAntispamAppsDescr"
		                    android:text="@string/viewAppsAntispamAppsDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		    <TextView
		            android:id="@+id/viewAppsPluginSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="2dp"
		            android:layout_below="@id/viewAppsAntispamLayout"
		            style="?android:attr/listSeparatorTextViewStyle"
		            android:background="@color/sdmmBlue2"
		            />
		    <RelativeLayout
		            android:id="@+id/viewAppsPluginLayout"
		            android:layout_below="@id/viewAppsPluginSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        <LinearLayout
		                android:id="@+id/viewAppsPluginBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsPluginBtn"
		                    android:onClick="viewMessagingApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewUnsafeAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
			            android:id="@+id/viewAppsPluginIcon"
			            android:layout_width="wrap_content"
			            android:layout_height="wrap_content"
			            android:src="@drawable/img_plugin"
			            android:background="@android:color/transparent"
			            android:layout_centerVertical="true"
			            android:padding="5dp"
			            />
		        <LinearLayout
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsPluginIcon"
		                android:layout_toLeftOf="@id/viewAppsPluginBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsPluginTitle"
		                    android:text="@string/viewAppsPluginTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsPluginDescr"
		                    android:text="@string/viewAppsPluginDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		    <TextView
		            android:id="@+id/viewAppsResponderSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="2dp"
		            android:layout_below="@id/viewAppsPluginLayout"
		            style="?android:attr/listSeparatorTextViewStyle"
		            android:background="@color/sdmmBlue2"
		            />
		    <RelativeLayout
		            android:id="@+id/viewAppsResponderLayout"
		            android:layout_below="@id/viewAppsResponderSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        <LinearLayout
		                android:id="@+id/viewAppsResponderBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsResponderBtn"
		                    android:onClick="viewMessagingApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewUnsafeAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
			            android:id="@+id/viewAppsResponderIcon"
			            android:layout_width="wrap_content"
			            android:layout_height="wrap_content"
			            android:src="@drawable/img_responder"
			            android:background="@android:color/transparent"
			            android:layout_centerVertical="true"
			            android:padding="5dp"
			            />
		        <LinearLayout
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsResponderIcon"
		                android:layout_toLeftOf="@id/viewAppsResponderBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsResponderTitle"
		                    android:text="@string/viewAppsResponderTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsResponderDescr"
		                    android:text="@string/viewAppsResponderDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		    <TextView
		            android:id="@+id/viewAppsBackupSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="2dp"
		            android:layout_below="@id/viewAppsResponderLayout"
		            style="?android:attr/listSeparatorTextViewStyle"
		            android:background="@color/sdmmBlue2"
		            />
		    <RelativeLayout
		            android:id="@+id/viewAppsBackupLayout"
		            android:layout_below="@id/viewAppsBackupSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        <LinearLayout
		                android:id="@+id/viewAppsBackupBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsBackupBtn"
		                    android:onClick="viewMessagingApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewUnsafeAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
			            android:id="@+id/viewAppsBackupIcon"
			            android:layout_width="wrap_content"
			            android:layout_height="wrap_content"
			            android:src="@drawable/img_backup"
			            android:background="@android:color/transparent"
			            android:layout_centerVertical="true"
			            android:padding="5dp"
			            />
		        <LinearLayout
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsBackupIcon"
		                android:layout_toLeftOf="@id/viewAppsBackupBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsBackupTitle"
		                    android:text="@string/viewAppsBackupTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsBackupDescr"
		                    android:text="@string/viewAppsBackupDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		    <TextView
		            android:id="@+id/viewAppsOtherSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="2dp"
		            android:layout_below="@id/viewAppsBackupLayout"
		            style="?android:attr/listSeparatorTextViewStyle"
		            android:background="@color/sdmmBlue2"
		            />
		    <RelativeLayout
		            android:id="@+id/viewAppsOtherLayout"
		            android:layout_below="@id/viewAppsOtherSeparator"
		            android:layout_width="match_parent"
		            android:layout_height="wrap_content"
		            android:background="@android:color/transparent"
		            android:layout_gravity="center_vertical"
		            >
		        <LinearLayout
		                android:id="@+id/viewAppsOtherBtnLayout"
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:layout_alignParentRight="true"
		                android:layout_centerVertical="true"
		                android:orientation="vertical"
		                >
		            <Button
		                    android:id="@+id/viewAppsOtherBtn"
		                    android:onClick="viewNonSMSApps"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:text="@string/viewAppsViewUnsafeAppsBtnTxt"
		                    android:layout_marginTop="10dip"
		                    android:layout_marginBottom="10dip"
		                    />
		        </LinearLayout>
		        <ImageView
			            android:id="@+id/viewAppsOtherIcon"
			            android:layout_width="wrap_content"
			            android:layout_height="wrap_content"
			            android:src="@drawable/img_other"
			            android:background="@android:color/transparent"
			            android:layout_centerVertical="true"
			            android:padding="5dp"
			            />
		        <LinearLayout
		                android:layout_width="wrap_content"
		                android:layout_height="wrap_content"
		                android:orientation="vertical"
		                android:layout_toRightOf="@id/viewAppsOtherIcon"
		                android:layout_toLeftOf="@id/viewAppsOtherBtnLayout"
		                android:layout_centerVertical="true"
		                >
		            <TextView
		                    android:id="@+id/viewAppsOtherTitle"
		                    android:text="@string/viewAppsOtherTitleTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginTop="10dip"
		                    android:textAppearance="?android:attr/textAppearanceMedium"
		                    />
		            <TextView
		                    android:id="@+id/viewAppsOtherDescr"
		                    android:text="@string/viewAppsOtherDescrTxt"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_marginBottom="10dip"
		                    android:textAppearance="?android:attr/textAppearanceSmall"
		                    />
		        </LinearLayout>
		    </RelativeLayout>
		</RelativeLayout>
	</ScrollView>
</RelativeLayout>
