<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Activity background color -->
    <drawable name="class_zero_background">#7f040000</drawable>

    <!-- text color -->
    <drawable name="text_color_red">#ffff4444</drawable>
    <drawable name="text_color_black">#ff000000</drawable>
    
    <!--  theming colors -->
    <color name="text_hairline">#ffcccccc</color>
    <color name="message_count_color">#66333333</color>
    
    <color name="compose_edit_text_color">#FF000000</color>

    <bool name="showAvatar">true</bool>
    <bool name="fillMsgWidth">true</bool>
    <bool name="use_divider_color">false</bool>
    
    <color name="divider_left_color">#FFFF0000</color>
    <color name="divider_center_color">#FF00FF00</color>
    <color name="divider_right_color">#FF0000FF</color>
    
    <color name="contact_action_bar_color">#FF000000</color>
        
    <dimen name="leftMsgPadding">0sp</dimen> 
    <dimen name="topMsgPadding">0sp</dimen> 
    <dimen name="rightMsgPadding">0sp</dimen> 
    <dimen name="bottomMsgPadding">0sp</dimen> 
    
