<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@drawable/setup_bg"
    >
    <ImageView 
        android:id="@+id/setupIcon"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:src="@drawable/setup_icon"
		/>
	<LinearLayout
		android:id="@+id/setupLayout"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:layout_marginTop="10dp"
		android:layout_centerInParent="true"
		android:background="@android:color/transparent"
		android:orientation="vertical"
		> 
		<TextView 
			android:id="@+id/setupTitleCommentsLbl" 
			android:text="@string/setupLblTxt"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:background="@android:color/transparent"
			android:textColor="@color/instWhite"
			/> 
		<TextView
			android:id="@+id/setupNotificationsOnTopSeparator"
			android:layout_width="fill_parent"
			android:layout_height="2dp"
			android:background="@android:color/white"
			style="?android:attr/listSeparatorTextViewStyle" 
			/>
		<ListView android:id="@android:id/list"
              android:layout_height="match_parent"
              android:layout_width="match_parent"/>
	</LinearLayout>
	<LinearLayout
	    android:id="@+id/setupContinueOptionsLayout"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:gravity="center"
		android:background="#333333"
		android:layout_alignParentBottom="true"
		>
        <Button 
            android:id="@+id/setupContinueAcceptBtn"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:maxLines="2"
			android:minWidth="50dip"
			android:maxHeight="48dp"
			android:text="@string/privacyAcceptBtnTxt"
			android:textColor="@color/instWhite"
			android:gravity="center"
			android:layout_marginBottom="10dp"
			android:onClick="setupContinue"
            />
	</LinearLayout>
</RelativeLayout>
